#!/bin/sh /etc/rc.common
# NoisyCompany on OpenWrt: UCI /etc/config/noisycompany -> TOML -> procd service.
START=99
USE_PROCD=1
STATE=/tmp/noisycompany   # RAM, spares the flash
CONF=$STATE/noisycompany.toml

bool() { [ "$1" = "1" ] && echo true || echo false; }

hours=""
add_hour() {  # only HH:MM-HH:MM reaches the TOML file
	case "$1" in [0-2][0-9]:[0-5][0-9]-[0-2][0-9]:[0-5][0-9]) hours="$hours${hours:+, }\"$1\"" ;; esac
}

write_config() {
	local preset daily_mb locale rhythm
	config_load noisycompany
	config_get preset main preset eco
	config_get daily_mb main daily_mb 3
	config_get locale main locale_packs 0
	config_get rhythm main weekly_rhythm 1
	config_list_foreach main active_hours add_hour
	case "$preset" in eco|balanced|max) ;; *) preset=eco ;; esac
	case "$daily_mb" in ''|*[!0-9.]*) daily_mb=3 ;; esac
	cat > "$CONF" <<TOML
[general]
preset = "$preset"
[budget]
daily_mb = $daily_mb
[schedule]
active_hours = [${hours:-"08:00-23:00"}]
[features]
appliance_packages = true
locale_packs = $(bool "$locale")
weekly_rhythm = $(bool "$rhythm")
TOML
}

start_service() {
	local enabled
	config_load noisycompany
	config_get enabled main enabled 0
	[ "$enabled" = "1" ] || return 0
	mkdir -p "$STATE" && chown nobody "$STATE" && chmod 700 "$STATE"
	write_config
	chown nobody "$CONF"
	procd_open_instance
	procd_set_param env PYTHONPATH=/usr/lib/noisycompany
	procd_set_param command /usr/bin/python3 -m noisycompany run -c "$CONF" --state-dir "$STATE"
	procd_set_param respawn 3600 60 5
	procd_set_param user nobody
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger noisycompany
}
