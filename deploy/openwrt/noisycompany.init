#!/bin/sh /etc/rc.common
# OpenWrt procd service. Needs python3-light (~4 MB) and python3-urllib, python3-logging,
# python3-email (pulled by http.client), python3-openssl:
#   opkg update && opkg install python3-light python3-urllib python3-logging python3-email python3-openssl python3-codecs
#   pip is usually absent: copy src/noisycompany to /usr/lib/python3.*/site-packages/
# Then: cp noisycompany.init /etc/init.d/noisycompany && chmod +x it &&
#       /etc/init.d/noisycompany enable && /etc/init.d/noisycompany start
# Routers are always on: the eco preset keeps flash writes and traffic minimal.

START=99
USE_PROCD=1
STATE=/tmp/noisycompany   # RAM, spares the flash

start_service() {
	mkdir -p "$STATE" && chown nobody "$STATE"
	procd_open_instance
	procd_set_param command /usr/bin/python3 -m noisycompany run -p eco --state-dir "$STATE"
	procd_set_param respawn 3600 60 5
	procd_set_param user nobody
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
