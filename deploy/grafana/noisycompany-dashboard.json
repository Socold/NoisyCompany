{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "NoisyCompany",
  "uid": "noisycompany",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "privacy",
    "noisycompany"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Today",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "noisycompany_bytes_today"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Daily cap used",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * noisycompany_bytes_today / noisycompany_daily_cap_bytes"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Metered link",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "noisycompany_metered"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Sessions (24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(noisycompany_sessions_total[24h])"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Noise traffic",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(noisycompany_bytes_total[5m]) * 8",
          "legendFormat": "bit/s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pages",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(noisycompany_pages_total{result=\"ok\"}[1h])",
          "legendFormat": "ok"
        },
        {
          "refId": "B",
          "expr": "increase(noisycompany_pages_total{result=\"fail\"}[1h])",
          "legendFormat": "failed"
        },
        {
          "refId": "C",
          "expr": "increase(noisycompany_pages_total{result=\"robots_denied\"}[1h])",
          "legendFormat": "robots.txt"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DNS lookups",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(noisycompany_dns_lookups_total{result=\"ok\"}[1h])",
          "legendFormat": "ok"
        },
        {
          "refId": "B",
          "expr": "increase(noisycompany_dns_lookups_total{result=\"fail\"}[1h])",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Back-offs",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(noisycompany_paused_busy_total[1h])",
          "legendFormat": "your traffic high"
        },
        {
          "refId": "B",
          "expr": "increase(noisycompany_paused_budget_total[1h])",
          "legendFormat": "budget pacing"
        }
      ]
    }
  ]
}
